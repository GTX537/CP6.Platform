{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cp6.dev/release/pinned-trust-store.v1",
  "type": "object",
  "required": ["$schemaId", "policyVersion", "minimumAcceptedPolicyVersion", "acceptedHistoricalPolicyVersions", "storageAuthorities", "keys"],
  "properties": {
    "$schemaId": { "const": "https://schemas.cp6.dev/release/pinned-trust-store.v1" },
    "policyVersion": { "type": "integer", "minimum": 1 },
    "minimumAcceptedPolicyVersion": { "type": "integer", "minimum": 1 },
    "acceptedHistoricalPolicyVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "storageAuthorities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["accessMode", "accountId", "allowedPrefixes", "bucket", "endpointTemplate", "id", "jurisdiction", "maxObjectBytes", "provider"],
        "properties": {
          "accessMode": { "const": "AuthenticatedReadConditionalCreate" },
          "accountId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "allowedPrefixes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "enum": ["candidates/platform/", "objects/sha256/"] }
          },
          "bucket": { "const": "cp6-release" },
          "endpointTemplate": { "const": "https://{accountId}.r2.cloudflarestorage.com" },
          "id": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/storageAuthority" },
          "jurisdiction": { "const": "default" },
          "maxObjectBytes": { "const": 4194304 },
          "provider": { "const": "cloudflare-r2" }
        },
        "additionalProperties": false
      }
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["keyId", "purpose", "validFromUtc", "validUntilUtc", "publicKey"],
        "properties": {
          "keyId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "purpose": { "enum": ["oci", "candidate-locator"] },
          "validFromUtc": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/utcTimestamp" },
          "validUntilUtc": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/utcTimestamp" },
          "publicKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384,
            "pattern": "^-----BEGIN PUBLIC KEY-----\\n[A-Za-z0-9+/=\\n]+\\n-----END PUBLIC KEY-----$",
            "description": "Canonical LF-delimited PKIX PUBLIC KEY PEM for an ECDSA P-256 cosign key, without a trailing newline; keyId is the SHA-256 of its DER SubjectPublicKeyInfo."
          },
          "revokedAtUtc": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/utcTimestamp" },
          "revocationReason": { "type": "string", "minLength": 1, "maxLength": 4096 }
        },
        "dependentRequired": { "revokedAtUtc": ["revocationReason"], "revocationReason": ["revokedAtUtc"] },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
