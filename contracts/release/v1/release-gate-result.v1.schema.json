{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cp6.dev/release/release-gate-result.v1",
  "type": "object",
  "required": ["$schemaId", "createdAtUtc", "workflow", "inputSubjects", "gates", "conclusion"],
  "properties": {
    "$schemaId": { "const": "https://schemas.cp6.dev/release/release-gate-result.v1" },
    "createdAtUtc": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/utcTimestamp" },
    "workflow": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/workflowIdentity" },
    "inputSubjects": { "type": "array", "items": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/evidenceSubject" }, "minItems": 1, "uniqueItems": true },
    "gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "subjectHash", "conclusion"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "subjectHash": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/sha256" },
          "conclusion": { "enum": ["Success", "Failure"] }
        },
        "additionalProperties": false
      }
    },
    "conclusion": { "enum": ["Success", "Failure"] }
  },
  "additionalProperties": false
}
