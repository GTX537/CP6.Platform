{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cp6.dev/release/release-common.v1",
  "type": "object",
  "properties": {},
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "releaseTag": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "storageAuthority": {
      "const": "cp6-release-r2-v1"
    },
    "objectReference": {
      "type": "object",
      "required": ["storageAuthority", "key", "mediaType", "sha256", "byteLength"],
      "properties": {
        "storageAuthority": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/storageAuthority" },
        "key": {
          "type": "string",
          "pattern": "^objects/sha256/[0-9a-f]{2}/[0-9a-f]{64}/[a-z0-9][a-z0-9.-]{0,127}\\.json$"
        },
        "mediaType": {
          "enum": [
            "application/vnd.cp6.system-release-manifest.v1+json",
            "application/vnd.cp6.candidate-result.v2+json",
            "application/vnd.cp6.candidate-locator.v1+json",
            "application/vnd.cp6.platform-release-candidate.v1+json",
            "application/vnd.cp6.release-gate-result.v1+json",
            "application/vnd.cp6.system-lineage-bootstrap-evidence.v1+json",
            "application/vnd.cp6.evidence-record.v1+json",
            "application/vnd.cp6.build-invocation-provenance.v1+json",
            "application/vnd.cp6.test-package-transport.v1+json",
            "application/vnd.cp6.pinned-trust-store.v1+json",
            "application/vnd.oai.openapi+json;version=3.1",
            "application/schema+json",
            "application/spdx+json",
            "application/vnd.cyclonedx+json",
            "application/sarif+json",
            "application/vnd.in-toto+json",
            "application/vnd.dev.sigstore.bundle.v0.3+json"
          ]
        },
        "sha256": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 4194304 }
      },
      "additionalProperties": false
    },
    "packageIdentity": {
      "type": "object",
      "required": [
        "packageId",
        "version",
        "sourceGitSha",
        "authorSignedPackageSha256",
        "publishedPackageSha256",
        "feedIdentity",
        "feedTransformation",
        "signerFingerprint",
        "timestampPolicy"
      ],
      "properties": {
        "packageId": { "type": "string", "pattern": "^CP6\\.Platform\\.[A-Za-z]+$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourceGitSha": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/gitSha" },
        "authorSignedPackageSha256": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/sha256" },
        "publishedPackageSha256": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/sha256" },
        "feedIdentity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "feedTransformation": { "enum": ["None", "Documented"] },
        "signerFingerprint": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/sha256" },
        "timestampPolicy": { "enum": ["Rfc3161Required", "TestOnlyNone"] }
      },
      "additionalProperties": false
    },
    "workflowIdentity": {
      "type": "object",
      "required": ["repository", "workflowPath", "workflowFileSha", "commitSha", "runId", "runAttempt", "environment"],
      "properties": {
        "repository": { "type": "string", "pattern": "^GTX537/CP6(?:\\.Platform|\\.CRM|\\.Portal)?$" },
        "workflowPath": { "type": "string", "pattern": "^\\.github/workflows/[a-z0-9][a-z0-9.-]*\\.ya?ml$" },
        "workflowFileSha": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/gitSha" },
        "commitSha": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/gitSha" },
        "runId": { "type": "integer", "minimum": 1 },
        "runAttempt": { "type": "integer", "minimum": 1 },
        "environment": { "type": "string", "minLength": 1, "maxLength": 64 },
        "conclusion": { "enum": ["Success", "Failure"] }
      },
      "additionalProperties": false
    },
    "evidenceSubject": {
      "type": "object",
      "required": ["subjectKind", "subjectName", "sha256OrDigest", "sourceGitSha"],
      "properties": {
        "subjectKind": { "type": "string", "minLength": 1, "maxLength": 64 },
        "subjectName": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256OrDigest": { "type": "string", "pattern": "^(?:[0-9a-f]{64}|sha256:[0-9a-f]{64})$" },
        "sourceGitSha": { "$ref": "https://schemas.cp6.dev/release/release-common.v1#/$defs/gitSha" }
      },
      "additionalProperties": false
    }
  }
}
