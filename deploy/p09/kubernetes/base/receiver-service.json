{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "receiver",
    "namespace": "cp6-p09-ci",
    "labels": { "cp6.io/nondeployable": "true" }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": { "cp6.io/workload": "receiver" },
    "ports": [{ "name": "http", "port": 80, "targetPort": 8080, "protocol": "TCP" }]
  }
}
