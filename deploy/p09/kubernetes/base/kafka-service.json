{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "kafka",
    "namespace": "cp6-p09-ci",
    "labels": { "cp6.io/nondeployable": "true" }
  },
  "spec": {
    "type": "ClusterIP",
    "selector": { "cp6.io/workload": "kafka" },
    "ports": [{ "name": "kafka", "port": 9092, "targetPort": 9092, "protocol": "TCP" }]
  }
}
