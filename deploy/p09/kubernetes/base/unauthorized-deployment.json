{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "unauthorized",
    "namespace": "cp6-p09-ci",
    "labels": { "cp6.io/nondeployable": "true" }
  },
  "spec": {
    "replicas": 0,
    "selector": { "matchLabels": { "cp6.io/workload": "unauthorized" } },
    "template": {
      "metadata": {
        "labels": {
          "cp6.io/nondeployable": "true",
          "cp6.io/workload": "unauthorized",
          "cp6.io/component": "probe"
