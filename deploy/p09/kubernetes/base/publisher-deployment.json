{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "publisher",
    "namespace": "cp6-p09-ci",
    "labels": { "cp6.io/nondeployable": "true" }
  },
  "spec": {
    "replicas": 0,
    "selector": { "matchLabels": { "cp6.io/workload": "publisher" } },
    "template": {
      "metadata": {
        "labels": {
          "cp6.io/nondeployable": "true",
          "cp6.io/workload": "publisher",
          "cp6.io/component": "application",
          "cp6.io/kafka-client": "dapr-sidecar"
        },
        "annotations": {
          "dapr.io/enabled": "true",
          "dapr.io/app-id": "cp6-p09-probe-publisher",
          "dapr.io/app-port": "8080"
        }
      },
      "spec": {
        "serviceAccountName": "publisher",
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "p09-fixture",
            "image": "example.invalid/cp6/p09-fixture@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "imagePullPolicy": "IfNotPresent",
            "args": ["publish"],
            "ports": [{ "name": "http", "containerPort": 8080, "protocol": "TCP" }]
          }
        ]
      }
    }
  }
}
