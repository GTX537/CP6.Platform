<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CP6.Platform.EntityFramework</PackageId>
    <Description>Entity Framework integration for CP6 distributed services.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cp6PlatformEfNet10)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Cp6PlatformEfNet10)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages.net10.0.lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup Condition="'$(Cp6PlatformEfNet10)' == 'true' and '$(TargetFramework)' == 'net10.0'">
    <PackageVersion Update="Microsoft.EntityFrameworkCore" Version="[10.0.15]" />
    <PackageVersion Update="Microsoft.EntityFrameworkCore.Relational" Version="[10.0.15]" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../CP6.Platform.Abstractions/CP6.Platform.Abstractions.csproj" />
    <ProjectReference Include="../CP6.Platform.Contracts/CP6.Platform.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CP6.Platform.UnitTests" />
  </ItemGroup>
</Project>
