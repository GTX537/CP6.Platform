<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>CP6.Platform.Messaging</PackageId>
    <Description>Messaging infrastructure for CP6 distributed services.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CP6.Platform.Abstractions/CP6.Platform.Abstractions.csproj" />
    <ProjectReference Include="../CP6.Platform.Contracts/CP6.Platform.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CloudNative.CloudEvents" />
    <PackageReference Include="CloudNative.CloudEvents.SystemTextJson" />
    <PackageReference Include="Dapr.Client" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../contracts/contract-bundle.v1.json" Pack="true" PackagePath="contracts/contract-bundle.v1.json" />
    <None Include="../../contracts/events/**/*" Pack="true" PackagePath="contracts/events/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
