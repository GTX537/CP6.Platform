                    "CP6.Platform.EntityFramework",
                    "CP6.Platform.Messaging",
                    "CP6.Platform.Release"
                  ]
                },
                "version": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "sourceGitSha": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{40}$",
                  "minLength": 40,
                  "maxLength": 40
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "minLength": 64,
                  "maxLength": 64
                },
                "feedIdentity": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            {
              "properties": {
                "packageId": {
                  "const": "CP6.Platform.Abstractions"
