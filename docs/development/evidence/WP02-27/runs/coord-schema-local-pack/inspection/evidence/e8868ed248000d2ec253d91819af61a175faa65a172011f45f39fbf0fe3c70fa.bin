{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schemaId",
    "matrixSha256",
    "sourceGitSha",
    "repository",
    "requestedRowSha256",
    "compatibilityDecision",
    "packages",
    "evidenceSha256",
    "publicationSha256",
    "trustPolicySha256"
  ],
  "properties": {
    "$schemaId": {
      "const": "https://schemas.cp6.dev/release/capabilities/v1/consumer-lock"
    },
    "matrixSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "sourceGitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "repository": {
      "const": "https://github.com/GTX537/CP6.Platform"
    },
    "requestedRowSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "minLength": 64,
      "maxLength": 64
    },
    "compatibilityDecision": {
      "enum": [
        "Allowed",
        "Blocked",
        "Unknown"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
